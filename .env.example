# ===========================================================================
# AgentGuard Environment Configuration
# ===========================================================================

# ---------------------------------------------------------------------------
# LLM Provider API Keys
# You only need keys for the providers you plan to use.
# Free-tier keys are available from:
#   - Groq:    https://console.groq.com
#   - Cohere:  https://dashboard.cohere.com
#   - Gemini:  https://aistudio.google.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Commercial Providers
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------------------------------
# Model Selection (Any model supported by LiteLLM)
# ---------------------------------------------------------------------------
# Attacker Model: Fast model used to generate dynamic attack probes
AGENTGUARD_ATTACKER_MODEL=groq/openai/gpt-oss-20b

# Reporter Model: Analytical model for synthesizing final remediation reports
AGENTGUARD_REPORTER_MODEL=cohere/command-r-08-2024

# Chat / Judge Model: Used for oracle verification and evaluation
AGENTGUARD_CHAT_MODEL=groq/openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Rate Limiting & Execution Tuning (Optional)
# ---------------------------------------------------------------------------
# Delay in seconds between individual attack probes
AGENTGUARD_PROBE_DELAY_SECONDS=0.5

# Delay in seconds between test categories
AGENTGUARD_CATEGORY_COOLDOWN=2.0

# HTTP timeout in seconds for target requests
AGENTGUARD_TIMEOUT_SECONDS=30.0
